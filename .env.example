# How the app reaches the bridge API.
#
# Recommended (same-origin via reverse proxy): "/bridge". HouseGraph's web server
# proxies /bridge/* -> the bridge in production, and vite.config.ts proxies it in
# dev. This avoids CORS and needing client devices to resolve bridge.local.
VITE_BRIDGE_URL=/bridge

# Alternative (direct): point straight at the bridge. Requires the bridge's CORS
# to allow this app's origin, and client devices to reach the host on that port.
# VITE_BRIDGE_URL=http://bridge.local:3000
